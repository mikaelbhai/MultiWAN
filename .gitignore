# Real site configuration: real Wi-Fi password, static IP and other live secrets.
# MultiWAN/config/mwan.env.example is the template; copy it to mwan.env and fill it in.
MultiWAN/config/mwan.env

# Router backups and migrations: root password hash, SSH host keys, Wi-Fi keys in plaintext.
backups/
backup.json
migration-*/
beta-from-*/
stock-backup/
DO-NOT-FLASH/

# Firmware images, vendor drops, built bundles, archives.
*.bin
*.img
*.zip
*.tar.gz
*.pdf
fw/
openwrt-*/
linksys-stock/

# Android: signing key, Firebase files, build output, built apps.
android-app/release.keystore
android-app/release.keystore.password.txt
android-app/firebase-key.json
android-app/google-services.json
android-app/local.properties
android-app/build/
android-app/.gradle/
*.apk
*.idsig

# Website secrets and state (the portal's database and keys live on the host, outside the repo).
portal/*.sqlite*
portal/firebase-key.json
portal/firebase-access.json
portal/alertd.beat
portal/*.log
portal/*.lock

# Local scratch
*.log
__pycache__/
