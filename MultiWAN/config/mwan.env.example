# MultiWAN site configuration — EDIT THIS FILE BEFORE RUNNING install.sh
#
# Every script in config/ sources this file. It is the single place you set
# site-specific values. Copy it to the router alongside the other scripts.

# ---------------------------------------------------------------------------
# PORT ROLE ASSIGNMENT
# ---------------------------------------------------------------------------
# DSA port names on Archer C6 v3: wan, lan1, lan2, lan3, lan4
# All five are gigabit. Any port can take any role.
#
# Default: 3 WAN + 2 LAN. Changing these here changes the boot-time default;
# the admin UI can also reassign roles at runtime.

PORT_WAN1="wan"          # highest priority, static, gigabit line
PORT_WAN2="lan1"         # secondary, DHCP, 100 Mb
PORT_WAN3="lan2"         # tertiary, DHCP, 100 Mb
PORTS_LAN="lan3 lan4"    # space-separated, bridged into br-lan

# ---------------------------------------------------------------------------
# WAN1 — HIGHEST PRIORITY LINK. *** YOU MUST CONFIGURE THIS ***
# ---------------------------------------------------------------------------
# WAN1_PROTO selects how this link gets its address:
#   static  — fixed IP/netmask/gateway/DNS supplied below
#   dhcp    — address from the upstream (most ethernet handoffs, cable, and
#             any ISP router you are sitting behind)
#   pppoe   — PPPoE session with username/password (common on VDSL/some fibre)
#
# install.sh validates only the fields the chosen proto actually needs.

WAN1_PROTO="static"                # static | dhcp | pppoe

# --- used when WAN1_PROTO="static" -----------------------------------------
# install.sh refuses to run while these are still the documentation placeholders.
WAN1_IPADDR="203.0.113.10"        # <-- your static IP
WAN1_NETMASK="255.255.255.0"      # <-- your netmask
WAN1_GATEWAY="203.0.113.1"        # <-- your ISP gateway

# --- used when WAN1_PROTO="pppoe" ------------------------------------------
WAN1_PPPOE_USER=""                 # <-- your PPPoE username
WAN1_PPPOE_PASS=""                 # <-- your PPPoE password
WAN1_PPPOE_SERVICE=""              # optional; leave empty unless your ISP says otherwise

# --- used by all three protos ------------------------------------------------
# DNS is pinned here rather than taken from the ISP, so that name resolution
# does not change identity when mwan3 fails over. Applies to dhcp/pppoe too
# (peerdns is forced off on WAN1 for exactly this reason).
#
# If your ISP hands you its own resolver, you can put it first for lower
# latency while WAN1 is up — but it will very likely be unreachable when
# WAN1 is down, since ISP resolvers are usually only reachable from inside
# that ISP's own network. Keep a public fallback (shown here) behind it;
# 50-system-dhcp.sh adds Quad9 behind that for a third opinion. Order
# matters: dnsmasq prefers the first server that answers.
WAN1_DNS="1.1.1.1 8.8.8.8"        # <-- your DNS servers

# ---------------------------------------------------------------------------
# LAN
# ---------------------------------------------------------------------------
# 192.168.100.0/24 matches the subnet this network already used under the stock
# TP-Link firmware, so existing devices with hand-assigned addresses keep
# working and nothing has to be renumbered.
#
# It also avoids 192.168.0.x / 192.168.1.x, which collide with the default range
# of almost every other consumer router — that collision is what breaks AP mode
# and VPN-from-a-hotel scenarios.
#
# WATCH FOR: if any WAN uplink hands this router an address in 192.168.100.0/24
# (common when sitting behind another ISP router), you get a subnet collision and
# routing breaks in confusing ways. Check with `ip -4 addr` after install; if it
# happens, move the LAN to 192.168.101.0/24 or similar.

LAN_IPADDR="192.168.100.1"
LAN_NETMASK="255.255.255.0"
# Pool starts immediately after the router: .2 through .201.
# That leaves .202-.254 free for devices you want to pin by hand.
LAN_DHCP_START="2"                # .2
LAN_DHCP_LIMIT="200"              # through .201
LAN_DHCP_LEASE="12h"

# ---------------------------------------------------------------------------
# WIRELESS
# ---------------------------------------------------------------------------
# Same SSID on both bands: clients pick whichever is stronger and roam between
# them without a second network to choose from.
WIFI_SSID_24="MultiWAN"
WIFI_SSID_5="MultiWAN-5G"
WIFI_KEY="CHANGEME-min-8-chars"   # <-- change this
WIFI_ENCRYPTION="psk2"            # psk2 = WPA2. See 40-wireless.sh for WPA3.
WIFI_COUNTRY="US"                 # <-- your regulatory domain. Set correctly.

# Hidden SSID: the network stops appearing in scan lists and must be joined by
# typing the name manually.
#
# BE AWARE THIS IS NOT A SECURITY MEASURE. The name is still broadcast in plain
# text every time one of your own devices connects, so anyone scanning for a few
# minutes sees it anyway. What it reliably does cause: some phones and IoT
# devices connect slowly, roam badly between bands, or refuse to reconnect after
# a reboot. Your password is what protects the network. Set to 0 if you hit
# device problems.
WIFI_HIDDEN="0"

WIFI_GUEST_ENABLE="1"
WIFI_GUEST_SSID="MultiWAN-Guest"
WIFI_GUEST_KEY="CHANGEME-guest-pw"
GUEST_IPADDR="192.168.30.1"
GUEST_NETMASK="255.255.255.0"

# ---------------------------------------------------------------------------
# ADMIN UI
# ---------------------------------------------------------------------------
ADMIN_PORT="8080"                 # bound to LAN_IPADDR only, never 0.0.0.0

# External (WAN-facing) port for direct remote access (Method 2 on the Remote
# Access page), when enabled. Deliberately a DIFFERENT number from ADMIN_PORT:
# this is a port-forward (redirect) to LAN_IPADDR:ADMIN_PORT, not a listen
# address, so it must not collide with any pre-existing port-forward you may
# already have on this router (e.g. a camera or NAS forwarded to ADMIN_PORT's
# number already). Change this if 8443 is already in use by something else.
ADMIN_WAN_PORT="8443"

# A fixed LAN hostname for the admin UI, the same idea as tplinkwifi.net or
# a mesh router's app.setup — so "where do I browse to" survives a LAN IP
# change instead of depending on it. Resolved by the router's own dnsmasq
# (config/50-system-dhcp.sh) and kept pointed at whatever LAN_IPADDR
# currently is by package/init.d/mwadmin every time the LAN address changes,
# whether that change came from this app, LuCI, or a manual `uci set`.
# Only resolves for clients using this router as their DNS server (the
# default for anything on this LAN) — it is not a real, publicly resolvable
# domain and never leaves the LAN.
ROUTER_HOSTNAME="multiwan.router"

# The admin UI already answers on LAN_IPADDR's own port 80 (LuCI is removed
# entirely — see package/init.d/mwadmin). This second, dedicated LAN-only
# address (LAN_IPADDR's subnet + this host octet) exists purely so
# ROUTER_HOSTNAME has a stable target independent of the primary address.
# Default .254 sits above the DHCP pool above (.2-.201); check it doesn't
# collide with a static reservation you've made by hand in .202-.253 first.
ADMIN_ALIAS_HOST="254"

# ---------------------------------------------------------------------------
# MWAN3 HEALTH CHECK TUNING
# ---------------------------------------------------------------------------
# Full rationale for every value is in 30-mwan3.sh and docs/03.
# Do not change these without reading that first — they trade failover speed
# against false-positive risk.

W1_INTERVAL="2"; W1_TIMEOUT="2"; W1_COUNT="1"; W1_DOWN="2"; W1_UP="3"; W1_RELIABILITY="2"
W2_INTERVAL="5"; W2_TIMEOUT="3"; W2_COUNT="1"; W2_DOWN="3"; W2_UP="3"; W2_RELIABILITY="1"
W3_INTERVAL="5"; W3_TIMEOUT="3"; W3_COUNT="1"; W3_DOWN="3"; W3_UP="3"; W3_RELIABILITY="1"

# Tracking targets. Four independent anycast resolvers on separate networks, so
# that one provider having a bad day cannot trip a failover on its own.
TRACK_WAN1="1.1.1.1 8.8.8.8 9.9.9.9 208.67.222.222"
TRACK_WAN2="1.0.0.1 8.8.4.4 9.9.9.10"
TRACK_WAN3="1.0.0.1 8.8.4.4 9.9.9.10"

# ---------------------------------------------------------------------------
# MWAN3 MODE
# ---------------------------------------------------------------------------
# failover — WAN1 carries everything; WAN2/3 are backups only. (default)
# balance  — all ENABLED WANs carry traffic simultaneously, split by weight
#            below. mwan3 balances per-FLOW, not per-packet: one TCP/UDP
#            connection still rides a single uplink for its lifetime, but
#            different flows spread across links. Failover still happens in
#            this mode — a dead link just drops out of the weighted set.
MWAN_MODE="failover"          # failover | balance

# Used only when MWAN_MODE="balance". Higher = gets more new flows. Default
# ratio reflects WAN1 being gigabit vs WAN2/3 at 100 Mb.
WEIGHT_WAN1="10"
WEIGHT_WAN2="1"
WEIGHT_WAN3="1"

# ---------------------------------------------------------------------------
# PER-WAN ENABLE TOGGLE
# ---------------------------------------------------------------------------
# Set to 0 to pull a WAN out of the mwan3 pool entirely (no tracking pings
# sent, not counted in failover/balance) without deleting its config. The
# admin UI exposes the same toggle live; these are just boot-time defaults.
WAN1_ENABLED="1"
WAN2_ENABLED="1"
WAN3_ENABLED="1"

# ---------------------------------------------------------------------------
# CUSTOM PING TARGET
# ---------------------------------------------------------------------------
# Optional. Added as an extra track_ip on every enabled WAN, alongside the
# public anycast resolvers, so health checks also reflect reachability to
# your own infrastructure. Leave empty to skip.
PING_SERVER=""

# ---------------------------------------------------------------------------
# OPTIONAL FEATURES — set to 0 to save flash
# ---------------------------------------------------------------------------
FEAT_WIREGUARD="1"     # ~200 KB. Caps at ~90 Mbps on this CPU.
FEAT_DDNS="1"          # ~100 KB
FEAT_SQM="1"           # ~100 KB. Only usable on WAN2/WAN3. See docs/01.
FEAT_UPNP="1"          # ~150 KB
FEAT_SPEEDTEST="1"     # installs curl (~500 KB). Required for port auto-detect.
FEAT_ADBLOCK="1"       # ~110 KB + ~5 MB inside dnsmasq once enabled. Off by default even when installed.
FEAT_ALERTS="0"        # msmtp, ~76 KB. Email alerts on WAN outage — needs SMTP details filled in via the UI.
FEAT_DRIVES="0"        # ~1.6 MB. Share USB drives on the network, per-device access (panel: Drives).
# No FEAT_ flag for Remote Access: it uses dropbear's own ssh client (already on every install,
# confirmed to support -R forwarding) — nothing to install. Opt-in, configured entirely in the UI.
