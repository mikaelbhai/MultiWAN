#!/bin/sh /etc/rc.common
# mwblock — DNS forwarders behind the admin's site block list (see
# /usr/lib/mwadmin/block.sh). Starts nothing when no site is blocked.

START=98
STOP=10
USE_PROCD=1

start_service() {
    . /usr/lib/mwadmin/block.sh
    block_gen
    local f
    for f in "$B_DIR"/g*.conf; do
        [ -f "$f" ] || continue
        procd_open_instance "$(basename "$f" .conf)"
        procd_set_param command /usr/sbin/dnsmasq -k -C "$f"
        procd_set_param respawn 3600 2 0
        procd_close_instance
    done
}

service_started() {
    . /usr/lib/mwadmin/block.sh
    if [ -s "$B_NFT" ]; then
        # give the forwarders a moment to open their ports before DNS is
        # pointed at them
        sleep 1
        block_table_load
        pause_sync
    else
        block_table_remove
    fi
}

stop_service() {
    nft delete table inet mwblock 2>/dev/null
}
