#!/bin/sh /etc/rc.common
# /etc/init.d/mwadmin — MultiWAN admin UI service.
#
# Does not run a server of its own. It configures a dedicated uhttpd instance
# bound to the LAN address and lets uhttpd's own init script supervise it.
# One less daemon, one less thing to keep alive on a router.

START=95
STOP=10

USE_PROCD=1

WWW_ROOT="/www/mwadmin"

configure_uhttpd() {
    local lan_ip port admin_ip is_router=1

    lan_ip=$(uci -q get network.lan.ipaddr)
    port=$(uci -q get mwadmin.@main[0].port 2>/dev/null)
    [ -z "$port" ] && port=8080

    # In AP mode the LAN is a DHCP client, so there is no configured ipaddr.
    # Fall back to the address actually assigned to br-lan.
    if [ -z "$lan_ip" ]; then
        lan_ip=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
        is_router=0
    fi

    if [ -z "$lan_ip" ]; then
        logger -t mwadmin "No LAN address available; admin UI not started."
        return 1
    fi

    # LuCI has no real backend on this build (no /usr/lib/lua/luci at all —
    # confirmed live; only a dead redirect page and a 403-ing stub script
    # were ever there) and this app is meant to be the only thing reachable
    # on this router, full stop — so its uhttpd instance is removed outright
    # rather than just narrowed to coexist with it, unconditionally, not
    # only when the admin_ip alias below happens to be configured.
    disable_luci

    # The port-80 alias only makes sense in Router mode: it's a second static
    # address on our own bridge, and in AP mode "our own bridge" is a DHCP
    # client on somebody else's network we don't control — statically
    # claiming an address there could collide with a real device on it.
    [ "$is_router" = "1" ] && admin_ip=$(sync_admin_alias "$lan_ip")

    # ---------------------------------------------------------------------
    # THE SECURITY-CRITICAL LINE
    # ---------------------------------------------------------------------
    # listen_http/listen_https only ever get specific LAN addresses — lan_ip
    # itself (on :80, :443, and :<port>) and, if the dedicated alias exists,
    # "<admin_ip>:80" — never "0.0.0.0:<port>". Binding to specific addresses
    # means the socket does not exist on the WAN interfaces at all. Even if a
    # firewall rule were later added by mistake, there would be nothing
    # listening on the WAN side to accept a connection. The firewall rule in
    # config/20-firewall.sh is the second layer, not the only one.
    uci set uhttpd.mwadmin='uhttpd'
    uci -q delete uhttpd.mwadmin.listen_http
    uci -q delete uhttpd.mwadmin.listen_https
    uci add_list uhttpd.mwadmin.listen_http="${lan_ip}:${port}"
    uci add_list uhttpd.mwadmin.listen_http="${lan_ip}:80"
    [ -n "$admin_ip" ] && uci add_list uhttpd.mwadmin.listen_http="${admin_ip}:80"
    # Reuses the self-signed cert OpenWrt's own uhttpd defaults already
    # generate for LuCI (now removed) — real TLS, just not one a browser
    # will trust by default without clicking through a warning once. A real
    # certificate needs a real domain and a CA that can verify it, which a
    # bare LAN IP structurally cannot have; this is still strictly better
    # than the plain-HTTP-only alternative for anything reachable off this
    # one router.
    if [ -f /etc/uhttpd.crt ] && [ -f /etc/uhttpd.key ]; then
        uci add_list uhttpd.mwadmin.listen_https="${lan_ip}:443"
        uci set uhttpd.mwadmin.cert='/etc/uhttpd.crt'
        uci set uhttpd.mwadmin.key='/etc/uhttpd.key'
    fi
    uci set uhttpd.mwadmin.home="$WWW_ROOT"
    uci set uhttpd.mwadmin.cgi_prefix='/cgi-bin'
    uci set uhttpd.mwadmin.index_page='index.html'
    uci set uhttpd.mwadmin.rfc1918_filter='1'
    uci set uhttpd.mwadmin.max_requests='6'
    uci set uhttpd.mwadmin.max_connections='30'
    # Speed tests and backups can legitimately take a while; the default 60 s
    # would cut them off mid-transfer.
    uci set uhttpd.mwadmin.script_timeout='120'
    uci set uhttpd.mwadmin.network_timeout='60'
    uci set uhttpd.mwadmin.no_dirlists='1'
    uci set uhttpd.mwadmin.no_symlinks='1'
    uci commit uhttpd

    if [ -n "$admin_ip" ]; then
        logger -t mwadmin "admin UI configured on ${lan_ip}:${port} and ${admin_ip}:80"
    else
        logger -t mwadmin "admin UI configured on ${lan_ip}:${port}"
    fi

    # The friendly hostname should land on the bare-port-80 alias when one
    # exists (that's the whole point of it), otherwise on lan_ip:port.
    sync_hostname_alias "${admin_ip:-$lan_ip}"
}

# Keeps config/10-network.sh's "lan_admin" alias interface — the dedicated
# LAN-only address the admin UI binds port 80 on, so ROUTER_HOSTNAME needs no
# ":8080" suffix — inside whatever subnet the LAN currently is. Only the host
# octet is preserved; the network part is recomputed from lan_ip every time,
# so this self-heals the same way sync_hostname_alias does. Prints the
# (possibly just-updated) alias address, or nothing if the feature was never
# installed.
sync_admin_alias() {
    local lan_ip="$1" cur host_octet new_ip

    cur=$(uci -q get network.lan_admin.ipaddr)
    [ -z "$cur" ] && return 0

    host_octet="${cur##*.}"
    new_ip="${lan_ip%.*}.$host_octet"

    if [ "$new_ip" != "$cur" ]; then
        uci set network.lan_admin.ipaddr="$new_ip"
        uci commit network
        logger -t mwadmin "admin alias address repointed: $cur -> $new_ip"
        # Bring the new address up. Network config just changed again, so
        # this fires our own reload trigger once more; that second pass finds
        # nothing left to change (new_ip = cur by then) and returns at once —
        # not a loop, just one harmless extra round trip.
        /etc/init.d/network reload
        # Then WAIT for netifd to actually put the address on br-lan. The
        # caller builds uhttpd's listen list from the value returned here and
        # binds it immediately, and uhttpd silently discards any listen
        # address that does not exist at bind time — so returning too early
        # leaves the friendly hostname pointing at an address nothing is
        # listening on, until some later unrelated restart happens to re-run
        # this. Same asynchronous-netifd trap as api_lan_set's rebind.
        local w=0
        while [ "$w" -lt 15 ]; do
            ip -4 -o addr show dev br-lan 2>/dev/null | grep -q "inet $new_ip/" && break
            sleep 1
            w=$((w + 1))
        done
        cur="$new_ip"
    fi

    printf '%s' "$cur"
}

# Removes uhttpd's "main" instance (LuCI's) outright, idempotently — a no-op
# once it's already gone. LuCI's default wildcard bind on 0.0.0.0:80 would
# otherwise block ANY other process from binding any address on that same
# port (a Linux socket rule, not LuCI-specific), which is what originally
# forced the separate admin_ip:80 alias workaround below to exist in the
# first place — that alias is kept for the friendly-hostname convenience it
# still provides, but freeing port 80 itself no longer depends on it.
disable_luci() {
    uci -q get uhttpd.main >/dev/null 2>&1 || return 0
    uci -q delete uhttpd.main
    uci commit uhttpd
    logger -t mwadmin "removed LuCI's uhttpd instance — no working backend existed behind it, and this app is meant to be the only thing reachable here"
}

# Keeps the friendly hostname (config/50-system-dhcp.sh's "mwadmin_alias"
# domain record, e.g. multiwan.router) pointed at wherever the admin UI actually
# listens on port 80 (the alias address if one exists, else the LAN address).
# Runs on every start/reload, so it self-heals whether that address changed
# via this app, LuCI, or a manual `uci set` over SSH. A no-op section (only
# touches it if the install script created it) means installs from before
# this existed, or with ROUTER_HOSTNAME unset, are unaffected.
sync_hostname_alias() {
    local target_ip="$1" cur

    cur=$(uci -q get dhcp.mwadmin_alias.ip)
    [ -z "$cur" ] && return 0
    [ "$cur" = "$target_ip" ] && return 0

    uci set dhcp.mwadmin_alias.ip="$target_ip"
    uci commit dhcp
    /etc/init.d/dnsmasq restart

    logger -t mwadmin "hostname alias $(uci -q get dhcp.mwadmin_alias.name) repointed: ${cur} -> ${target_ip}"
}

start_service() {
    # uci can add sections to an existing package file but cannot conjure the
    # file itself from nothing — without this, every api.sh call that writes
    # to the "mwadmin" uci config (alerts settings, the custom admin port,
    # nodes) fails silently with "uci: Entry not found" the first time it
    # runs on a fresh install, before anything has ever written to it.
    [ -f /etc/config/mwadmin ] || touch /etc/config/mwadmin

    configure_uhttpd || return 1

    mkdir -p /tmp/mwadmin/ports /tmp/mwadmin/locks
    mkdir -p /etc/mwadmin/portdata /etc/mwadmin/profiles

    # Record the initial mode so the UI has something to show on a fresh install.
    [ -f /etc/mwadmin/mode ] || echo router > /etc/mwadmin/mode

    # Snapshot the working router config on first start. This is what the AP
    # mode rollback restores, so it must exist before the user can switch.
    if [ ! -d /etc/mwadmin/profiles/router ]; then
        sh /usr/lib/mwadmin/modeswitch.sh save-profile router
    fi

    # Per-device internet caps are a tc tree, which lives entirely in kernel
    # memory and is therefore gone after any reboot or network restart.
    # Rebuilding here means a cap set once in the UI stays in force without
    # the user having to know that.
    sh /usr/lib/mwadmin/devlimit.sh apply >/dev/null 2>&1

    /etc/init.d/uhttpd reload
}

stop_service() {
    uci -q delete uhttpd.mwadmin
    uci commit uhttpd
    /etc/init.d/uhttpd reload
}

service_triggers() {
    # Rebind when the LAN address changes, otherwise the UI would keep
    # listening on an address the router no longer has.
    procd_add_reload_trigger "network" "mwadmin"
}

reload_service() {
    stop_service
    start_service
}
