#!/bin/sh /etc/rc.common
# /etc/init.d/mwexempt - the clean resolver for "never blocked" devices
# (see /usr/lib/mwadmin/allow.sh). Runs only while the list has devices.

START=99
STOP=10
USE_PROCD=1

start_service() {
    sh /usr/lib/mwadmin/allow.sh boot
    [ -s /tmp/mwadmin/exempt/dnsmasq.conf ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/dnsmasq -k -C /tmp/mwadmin/exempt/dnsmasq.conf
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
