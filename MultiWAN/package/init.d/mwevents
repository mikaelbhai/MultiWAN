#!/bin/sh /etc/rc.common
# /etc/init.d/mwevents - router event log (lines, cables, power, errors) and
# the uploader that copies it and the site activity to the website.

START=97
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /usr/lib/mwadmin/events.sh watch
    procd_set_param respawn 3600 10 0
    procd_close_instance
}

stop_service() {
    # the watcher's logread and upload loop are children of the instance
    for p in $(ps w | grep -E 'logread -f$|events.sh (watch|push)' | grep -v grep | awk '{print $1}'); do
        kill "$p" 2>/dev/null
    done
}
