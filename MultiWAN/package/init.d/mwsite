#!/bin/sh /etc/rc.common
# /etc/init.d/mwsite — peak-throughput tracker for the site card.
# One shell loop that reads /proc/net/dev every 5 s; see lib/site.sh.

START=97
STOP=10
USE_PROCD=1

start_service() {
    [ -x /usr/lib/mwadmin/site.sh ] || chmod 755 /usr/lib/mwadmin/site.sh 2>/dev/null
    procd_open_instance
    procd_set_param command /bin/sh /usr/lib/mwadmin/site.sh watch
    procd_set_param respawn 3600 10 0
    procd_set_param nice 10
    procd_close_instance
}
