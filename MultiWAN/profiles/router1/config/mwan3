# Router 1 (main router) - cleaned copy of the live settings. See ../README.md before using it.

config globals 'globals'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'

config interface 'wan1'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	option interval '1'
	option timeout '1'
	option count '1'
	option down '1'
	option up '3'
	option reliability '2'
	option initial_state 'online'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	list track_ip '9.9.9.9'
	list track_ip '208.67.222.222'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'disconnected'

config interface 'wan2'
	option enabled '1'
	option family 'ipv4'
	option track_method 'ping'
	option interval '5'
	option timeout '3'
	option count '1'
	option down '3'
	option up '3'
	option reliability '1'
	option initial_state 'online'
	list track_ip '1.0.0.1'
	list track_ip '8.8.4.4'
	list track_ip '9.9.9.10'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'disconnected'

config member 'wan1_m1'
	option interface 'wan1'
	option metric '1'
	option weight '1'

config member 'wan2_m2'
	option interface 'wan2'
	option metric '2'
	option weight '1'

config policy 'prio_failover'
	option last_resort 'unreachable'
	list use_member 'wan1_m1'
	list use_member 'wan2_m2'

config rule 'rule_localnets'
	option dest_ip '192.168.0.0/16'
	option proto 'all'
	option use_policy 'default'

config rule 'rule_rfc1918_10'
	option dest_ip '10.0.0.0/8'
	option proto 'all'
	option use_policy 'default'

config rule 'rule_rfc172'
	option dest_ip '172.16.0.0/12'
	option proto 'all'
	option use_policy 'default'

config policy 'line_wan1'
	option last_resort 'unreachable'
	list use_member 'wan1_ln1'
	list use_member 'wan2_ln1'

config member 'wan1_ln1'
	option interface 'wan1'
	option metric '1'
	option weight '1'

config member 'wan2_ln1'
	option interface 'wan2'
	option metric '2'
	option weight '1'

config policy 'line_wan2'
	option last_resort 'unreachable'
	list use_member 'wan2_ln2'
	list use_member 'wan1_ln2'

config member 'wan2_ln2'
	option interface 'wan2'
	option metric '1'
	option weight '1'

config member 'wan1_ln2'
	option interface 'wan1'
	option metric '2'
	option weight '1'

config rule 'rule_call_meta'
	option proto 'udp'
	option dest_port '1024:65535'
	option dest_ip '31.13.24.0/21,31.13.64.0/18,45.64.40.0/22,57.144.0.0/14,66.220.144.0/20,69.63.176.0/20,69.171.224.0/19,74.119.76.0/22,102.132.96.0/20,103.4.96.0/22,129.134.0.0/16,147.75.208.0/20,157.240.0.0/16,163.70.128.0/17,173.252.64.0/18,179.60.192.0/22,185.60.216.0/22,185.89.216.0/22,204.15.20.0/22'
	option use_policy 'line_wan2'

config rule 'rule_call_zoom'
	option proto 'udp'
	option dest_port '8801:8810'
	option dest_ip '0.0.0.0/0'
	option use_policy 'line_wan2'

config rule 'rule_zoom_tcp'
	option proto 'tcp'
	option dest_port '8801:8802'
	option dest_ip '0.0.0.0/0'
	option use_policy 'line_wan2'

config rule 'rule_call_meet'
	option proto 'udp'
	option dest_port '19302:19309'
	option dest_ip '0.0.0.0/0'
	option use_policy 'line_wan2'

config rule 'rule_call_rtc'
	option proto 'udp'
	option dest_port '3478:3481'
	option dest_ip '0.0.0.0/0'
	option use_policy 'line_wan2'

config rule 'rule_https'
	option dest_ip '0.0.0.0/0'
	option proto 'tcp'
	option dest_port '443'
	option sticky '1'
	option timeout '600'
	option use_policy 'prio_failover'

config policy 'policy_udp_pref'
	option last_resort 'unreachable'
	list use_member 'wan2_udppref'
	list use_member 'wan1_udppref'

config member 'wan2_udppref'
	option interface 'wan2'
	option metric '1'
	option weight '1'

config member 'wan1_udppref'
	option interface 'wan1'
	option metric '2'
	option weight '1'

config rule 'rule_udp_split'
	option dest_ip '0.0.0.0/0'
	option proto 'udp'
	option sticky '1'
	option timeout '600'
	option use_policy 'policy_udp_pref'

config rule 'rule_default'
	option dest_ip '0.0.0.0/0'
	option proto 'all'
	option sticky '1'
	option timeout '600'
	option use_policy 'prio_failover'

